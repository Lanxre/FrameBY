<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<title>Студенческие отряды</title>
<style>
  body { font-family: 'Segoe UI', Arial, sans-serif; max-width: 1100px; margin: 40px auto; padding: 0 20px; color: #333; }
  h1 { color: #059669; border-bottom: 2px solid #059669; padding-bottom: 10px; }
  h2 { color: #047857; margin-top: 30px; }
  .squad-card { border: 1px solid #e5e7eb; border-radius: 10px; padding: 20px; margin: 20px 0; background: #fff; }
  .squad-card:hover { box-shadow: 0 2px 8px rgba(0,0,0,0.08); }
  .info-grid { display: grid; grid-template-columns: 140px 1fr; gap: 6px; margin: 10px 0; font-size: 14px; }
  .info-label { font-weight: 600; color: #555; }
  table { width: 100%; border-collapse: collapse; margin: 10px 0; font-size: 14px; }
  th, td { padding: 8px 10px; text-align: center; vertical-align: middle; border: 1px solid #d1d5db; }
  th { background: #f0fdf4; color: #065f46; font-weight: 600; }
  tr:nth-child(even) { background: #f9fafb; }
  .status { display: inline-block; padding: 2px 8px; border-radius: 10px; font-size: 13px; }
  .status-open { background: #d1fae5; color: #065f46; }
  .status-pending { background: #fef3c7; color: #92400e; }
  .status-closed { background: #e5e7eb; color: #374151; }
  .status-rejected { background: #fee2e2; color: #991b1b; }
  .footer { margin-top: 40px; padding-top: 20px; border-top: 1px solid #e5e7eb; font-size: 13px; color: #9ca3af; text-align: center; }
  .subtitle { color: #666; font-size: 14px; margin: 0 0 12px; }
  .subtitle-sm { color: #666; font-size: 12px; margin: 0 0 12px; }
  .participants-count { font-size: 14px; color: #6b7280; }
  .section-title { color: #047857; font-weight: 600; font-size: 14px; margin: 10px 0 4px; }
  .section-body { color: #333; font-size: 13px; margin: 0 0 8px; line-height: 1.5; }
</style>
</head>
<body>
  <h1>Студенческие отряды • {{now}}</h1>
  {{if .RequesterLabel}}<p class="subtitle">{{.RequesterLabel}}</p>{{end}}
  <p>Всего: <strong>{{.Total}}</strong></p>

  {{range .Squads}}
  <div class="squad-card">
    <h2>{{.Title}}</h2>
    <p class="subtitle-sm">Создан: {{formatTime .CreatedAt}} • {{.OrganizerName}}</p>

    <div class="info-grid">
      <div class="info-label">Статус</div>
      <div><span class="status status-{{.StatusName}}">{{statusLabel .StatusName}}</span></div>
      <div class="info-label">Участники</div>
      <div class="participants-count">{{.CurrentCount}} / {{.MaxParticipants}}</div>
      {{if .OrganizerPosition}}<div class="info-label">Должность</div>
      <div>{{.OrganizerPosition}}</div>{{end}}
      {{if .OrganizerPhone}}<div class="info-label">Телефон</div>
      <div>{{.OrganizerPhone}}</div>{{end}}
      {{if .OrganizerEnterpriseName}}<div class="info-label">Компания</div>
      <div>{{.OrganizerEnterpriseName}}</div>{{end}}
      {{if .ApprovedByName}}<div class="info-label">Одобрено</div>
      <div style="color: #059669;">{{.ApprovedByName}}</div>{{end}}
    </div>

    {{if .Description}}
    <div class="section-title">Описание</div>
    <div class="section-body">{{.Description}}</div>
    {{end}}

    {{if .Profile}}
    <div class="section-title">Требования к участникам</div>
    <div class="section-body">{{.Profile}}</div>
    {{end}}

    {{$parts := index $.ParticipantsMap .ID}}
    {{if $parts}}
    <h3 style="margin: 12px 0 6px;">Участники ({{len $parts}})</h3>
    <table>
      <thead>
        <tr>
          <th style="width: 30px;">#</th>
          <th>Имя</th>
          <th>Телефон</th>
          <th>ВУЗ</th>
          <th>Специальность</th>
          <th style="width: 50px;">Курс</th>
        </tr>
      </thead>
      <tbody>
        {{range $i, $p := $parts}}
        <tr>
          <td style="text-align: center;">{{add1 $i}}</td>
          <td>{{$p.FullName}}</td>
          <td>{{orDash $p.Phone}}</td>
          <td>{{$p.University}}</td>
          <td>{{orDash $p.Specialty}}</td>
          <td style="text-align: center;">{{gradeStr $p.Grade}}</td>
        </tr>
        {{end}}
      </tbody>
    </table>
    {{end}}
  </div>
  {{end}}

  <div class="footer">Сгенерировано Frameby • {{now}}</div>
</body>
</html>
